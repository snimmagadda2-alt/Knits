{
  "name": "knits",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "Knits — a macOS-style desktop environment for .deb devices",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:web": "tsc --noEmit && vite build && node scripts/build-feed.mjs",
    "build": "npm run build:web && bash scripts/build-deb.sh",
    "deb": "bash scripts/build-deb.sh",
    "build:iso": "bash scripts/build-iso.sh",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
